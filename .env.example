# Copia este archivo como .env y completa con tus propios valores.
# NUNCA subas el .env real a git (ya está en .gitignore).

# Pooler en modo transacción (usado por Prisma Client en runtime)
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Conexión directa / pooler en modo sesión (usado por Prisma para migraciones)
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# Cambia a "false" (o quita la variable) cuando ya quieras usar Postgres real
USE_IN_MEMORY_DB=true
